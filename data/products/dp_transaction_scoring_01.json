{
  "version": "1.0",
  "project": {
    "id": "dp_transaction_scoring_01",
    "name": "Transaction Scoring Data Product",
    "description": "Core data product for inference and scoring analytics."
  },
  "connection": {
    "type": "postgres",
    "properties": {
      "host": "inference-db.internal.corp",
      "port": 5432,
      "database": "scoring_dw",
      "user": "${DB_USER}",
      "password": "${DB_PASSWORD}",
      "schema": "public"
    }
  },
  "mdl": {
    "models": [
      {
        "name": "customers",
        "tableReference": {
          "table": "dim_customers"
        },
        "description": "Customer dimension table",
        "columns": [
          {
            "name": "customer_id",
            "type": "integer",
            "primaryKey": true
          },
          {
            "name": "risk_segment",
            "type": "varchar"
          }
        ],
        "primaryKey": "customer_id"
      },
      {
        "name": "transactions",
        "tableReference": {
          "table": "fact_transactions"
        },
        "description": "Fact table for all scored transactions",
        "columns": [
          {
            "name": "transaction_id",
            "type": "integer",
            "primaryKey": true
          },
          {
            "name": "customer_id",
            "type": "integer"
          },
          {
            "name": "amount",
            "type": "double"
          },
          {
            "name": "inference_score",
            "type": "double"
          }
        ],
        "primaryKey": "transaction_id"
      }
    ],
    "relationships": [
      {
        "name": "customer_transactions",
        "models": [
          "transactions",
          "customers"
        ],
        "joinType": "MANY_TO_ONE",
        "condition": "transactions.customer_id = customers.customer_id"
      }
    ],
    "metrics": [
      {
        "name": "average_inference_score",
        "description": "Average model score across transactions",
        "baseObject": "transactions",
        "dimension": [],
        "measure": [
          {
            "name": "average_inference_score",
            "type": "DOUBLE",
            "expression": "avg(inference_score)"
          }
        ],
        "timeGrain": []
      }
    ],
    "views": []
  },
  "sql_pairs": [
    {
      "question": "What is the average transaction amount for high-risk customers?",
      "sql": "SELECT avg(t.amount) FROM fact_transactions t JOIN dim_customers c ON t.customer_id = c.customer_id WHERE c.risk_segment = 'High'"
    }
  ],
  "created_at": "2026-05-06T01:15:27.677657Z",
  "updated_at": "2026-05-09T22:29:53.695122Z",
  "status": "deployed",
  "mdl_hash": "50c0449b3e739f11c9a8742e2e1b6c723f82999e76e2ba5a8aac923703817541",
  "error": null
}