{
  "source": "postgres",
  "manifest": {
    "models": [
      {
        "name": "customers",
        "tableReference": {
          "table": "dim_customers"
        },
        "description": "Customer dimension table",
        "columns": [
          {
            "name": "customer_id",
            "type": "integer",
            "primaryKey": true
          },
          {
            "name": "risk_segment",
            "type": "varchar"
          }
        ],
        "primaryKey": "customer_id"
      },
      {
        "name": "transactions",
        "tableReference": {
          "table": "fact_transactions"
        },
        "description": "Fact table for all scored transactions",
        "columns": [
          {
            "name": "transaction_id",
            "type": "integer",
            "primaryKey": true
          },
          {
            "name": "customer_id",
            "type": "integer"
          },
          {
            "name": "amount",
            "type": "double"
          },
          {
            "name": "inference_score",
            "type": "double"
          }
        ],
        "primaryKey": "transaction_id"
      }
    ],
    "relationships": [
      {
        "name": "customer_transactions",
        "models": [
          "transactions",
          "customers"
        ],
        "joinType": "MANY_TO_ONE",
        "condition": "transactions.customer_id = customers.customer_id"
      }
    ],
    "metrics": [
      {
        "name": "average_inference_score",
        "description": "Average model score across transactions",
        "baseObject": "transactions",
        "dimension": [],
        "measure": [
          {
            "name": "average_inference_score",
            "type": "DOUBLE",
            "expression": "avg(inference_score)"
          }
        ],
        "timeGrain": []
      }
    ],
    "views": []
  },
  "connectionInfo": {
    "host": "inference-db.internal.corp",
    "port": 5432,
    "database": "scoring_dw",
    "user": "${DB_USER}",
    "password": "${DB_PASSWORD}",
    "schema": "public"
  }
}